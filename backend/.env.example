# ─────────────────────────────────────────────────────────────────────────────
# RAG Agent — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
# Model availability differs per account: older flash models (2.0 / 2.5) return 404 for newer accounts, and
# free-tier quotas are per model. gemini-flash-lite-latest worked where others were exhausted or unavailable.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=20

# ── RAG retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_HISTORY_PAIRS=5

# ── Query rewriting (turns follow-ups into standalone search queries) ─────────
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_MODEL=gemini-flash-lite-latest
QUERY_REWRITE_HISTORY_TURNS=3
QUERY_REWRITE_MAX_TOKENS=96

# ── Hybrid search + reranking (local CPU models, no API key) ──────────────────
# Hybrid needs a collection that has the BM25 sparse vector; for an existing collection run
# `python scripts/reindex_hybrid.py --target documents_hybrid` and set QDRANT_COLLECTION to it.
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=false
INCLUDE_CHUNK_METADATA_IN_PROMPT=false
SPARSE_MODEL=Qdrant/bm25
RERANKER_PROVIDER=local
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_COUNT=20
RRF_K=60
CANDIDATE_MULTIPLIER=4

# ── Agentic graph: router, chunk grading with a capped retry loop, groundedness, verified citations ──
ENABLE_AGENTIC_LOOP=true
MAX_RETRIEVAL_LOOPS=2
MIN_RELEVANT_CHUNKS=1
ENABLE_GROUNDEDNESS_CHECK=true
ENABLE_VERIFIED_CITATIONS=true
AGENT_MODEL=gemini-flash-lite-latest
AGENT_MAX_TOKENS=512
# Per-attempt LLM timeout and retries for the answering model (helper steps fail open instead of retrying)
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2

# ── Observability (Phase 6) ──────────────────────────────────────────────────
# USD per 1M tokens, used for the rag_llm_cost_usd_total metric (0 = free tier)
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# Langfuse tracing (self-hosted by docker-compose.observability.yml; UI at http://localhost:3002).
# The compose file seeds this project and these keys on first start, so choose your own random values.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
# Local Langfuse server secrets and its first admin login (only used by the Langfuse containers)
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_PASSWORD=change-me

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres           # 'postgres' inside Docker, 'localhost' for local dev
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant               # 'qdrant' inside Docker, 'localhost' for local dev
QDRANT_PORT=6333
QDRANT_API_KEY=                  # leave blank for self-hosted; required for Qdrant Cloud
QDRANT_COLLECTION=documents

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGINS=["*"]

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
